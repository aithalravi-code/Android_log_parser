{
    "name": "android-log-parser",
    "version": "1.0.0",
    "description": "Android Log Parser with E2E Testing",
    "type": "module",
    "scripts": {
        "dev": "vite --config .config/build/vite.config.js",
        "build": "vite build --config .config/build/vite.config.js",
        "preview": "vite preview --config .config/build/vite.config.js",
        "test:unit": "vitest --config .config/test/vitest.config.js",
        "test:regression": "playwright test -c .config/test/playwright.config.js",
        "test:ci": "playwright test -c .config/test/playwright.config.ci.js",
        "test:core": "playwright test -c .config/test/playwright.config.ci.js complete_workflows log_filtering_advanced"
    },
    "devDependencies": {
        "@playwright/test": "^1.40.1",
        "@vitest/ui": "^1.0.4",
        "fake-indexeddb": "^5.0.2",
        "vite": "^5.0.8",
        "vitest": "^1.0.4"
    }
}